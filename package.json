{
  "name": "@stackline/deep-is",
  "version": "1.0.1",
  "description": "Stack-safe deep equality with the proven deep-is 0.1.4 semantics",
  "type": "commonjs",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./index.d.mts",
        "require": "./index.d.cts",
        "default": "./index.d.ts"
      },
      "browser": {
        "import": "./dist/browser.mjs",
        "require": "./dist/browser.cjs"
      },
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.cts",
    "index.d.mts",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint index.js index.mjs scripts test docs-site",
    "test:upstream": "tape test/NaN.js test/cmp.js test/neg-vs-pos-0.js",
    "test:compatibility": "node test/compatibility.js",
    "test:depth": "node scripts/check-depth.mjs",
    "test:esm": "node test/esm.mjs",
    "test:types": "node node_modules/typescript-3-9/bin/tsc -p test/types/tsconfig.legacy.json && node node_modules/typescript/bin/tsc -p test/types/tsconfig.commonjs.json && node node_modules/typescript/bin/tsc -p test/types/tsconfig.modern.json",
    "test:browser": "node scripts/check-browser.mjs",
    "test": "npm run test:upstream && npm run test:compatibility && npm run test:depth && npm run test:esm && npm run test:types && npm run test:browser",
    "test:coverage": "c8 --check-coverage --lines 95 --functions 95 --branches 90 node test/compatibility.js",
    "test:smoke": "node scripts/smoke-install.mjs && node scripts/smoke-optionator.mjs",
    "test:docs": "npm run docs:build && node scripts/check-docs.mjs",
    "check:package": "publint && attw --pack .",
    "pack:check": "npm pack --dry-run",
    "audit:dependencies": "npm audit --omit=dev --audit-level=low",
    "audit:signatures": "npm audit signatures",
    "docs:build": "npm run build && node scripts/build-docs.mjs",
    "docs:serve": "node scripts/serve-docs.mjs",
    "verify": "npm run clean && npm run lint && npm run build && npm test && npm run test:coverage && npm run test:smoke && npm run check:package && npm run pack:check && npm run test:docs && npm run audit:dependencies",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-deep-is.git"
  },
  "homepage": "https://alexandro.net/docs/vanilla/deep-is/",
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-deep-is/issues"
  },
  "keywords": [
    "deep-equal",
    "deep-equality",
    "equality",
    "compare",
    "cycle-safe",
    "stack-safe",
    "stackline"
  ],
  "author": "Stackline Maintainers",
  "contributors": [
    "Thorsten Lorenz",
    "James Halliday",
    "Thomas Robinson"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=12"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "publint": "0.3.24",
    "tape": "5.10.2",
    "typescript": "7.0.2",
    "typescript-3-9": "npm:typescript@3.9.10"
  }
}
